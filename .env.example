# Copy to .env.local and fill in before running `npm run dev`.

# Clerk publishable key — Clerk dashboard → Configure → API keys.
# Use a development instance key (pk_test_...).
VITE_CLERK_PUBLISHABLE_KEY=

# Backend services — defaults match motifpath-core's docker-compose + `go run`.
VITE_CORE_API_URL=http://localhost:8080
VITE_EVENTS_API_URL=http://localhost:8081
