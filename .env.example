# Copy to .env.local and fill in before running `npm run dev`.

# Clerk PUBLISHABLE key — Clerk dashboard → Configure → API keys.
# The pk_test_... value (safe for the browser). The matching sk_test_... SECRET
# key is a backend concern — it goes in motifpath-core's services/*/.env as
# CLERK_SECRET_KEY, never here.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend services — defaults match motifpath-core's local stack
# (`mise run services` / docker-compose).
VITE_CORE_API_URL=http://localhost:8080
VITE_EVENTS_API_URL=http://localhost:8081

# Concierge WhatsApp number for the student "Send to your teacher" button, in
# international format (any spacing or dashes are fine). Leave empty to hide the button.
VITE_CONCIERGE_WHATSAPP_NUMBER=
