    "cell-6-1": { "kind": "fretboard_cell", "item_key": "fretboard_cell:instrument-guitar:6:1", "label": "F — string 6, fret 1", "skill_ids": [], "concept_ids": [], "instrument_id": "instrument-guitar", "string": 6, "fret": 1, "note_name": "F" },
    "cell-6-2": { "kind": "fretboard_cell", "item_key": "fretboard_cell:instrument-guitar:6:2", "label": "F# — string 6, fret 2", "skill_ids": [], "concept_ids": [], "instrument_id": "instrument-guitar", "string": 6, "fret": 2, "note_name": "F#" },
    "minor-third": { "kind": "exercise", "item_key": "exercise:exercise-minor-third", "label": "From A, which note is the minor third?", "skill_ids": [], "concept_ids": [], "exercise_id": "exercise-minor-third", "estimated_seconds": 20 },
    "pentatonic-run": { "kind": "play_along", "item_key": "play_along:diagram-pentatonic-run", "label": "Alternate picking", "skill_ids": [], "concept_ids": [], "diagram_id": "diagram-pentatonic-run", "purpose": "technique", "params": { "start_bpm": 70, "target_bpm": 120, "step_bpm": 5, "cleans_to_advance": 2, "loops": 2, "count_in_beats": 4 } },
    "am-c": { "kind": "chord_change", "item_key": "chord_change:diagram-a-minor:diagram-c-major", "label": "Am ↔ C changes", "skill_ids": [], "concept_ids": [], "from_diagram_id": "diagram-a-minor", "to_diagram_id": "diagram-c-major", "target_changes_per_minute": 60 }
