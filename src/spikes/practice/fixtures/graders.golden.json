  "cases": [
    { "name": "name the note: right", "item": "cell-5-3", "response": { "kind": "name_the_note", "chosen_note": "C", "latency_ms": 1800 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": true, "latency_ms": 1800 } } },
    { "name": "name the note: wrong", "item": "cell-5-3", "response": { "kind": "name_the_note", "chosen_note": "D", "latency_ms": 2500 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": false, "latency_ms": 2500 } } },
    { "name": "name the note: a flat spelling of the same pitch is right", "item": "cell-6-2", "response": { "kind": "name_the_note", "chosen_note": "Gb", "latency_ms": 2100 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": true, "latency_ms": 2100 } } },
    { "name": "find the note: right fret", "item": "cell-6-1", "response": { "kind": "find_the_note", "string": 6, "fret": 1, "latency_ms": 1500 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": true, "latency_ms": 1500 } } },
    { "name": "find the note: same note an octave up on the same string is right", "item": "cell-6-1", "response": { "kind": "find_the_note", "string": 6, "fret": 13, "latency_ms": 1500 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": true, "latency_ms": 1500 } } },
    { "name": "find the note: same note on another string is wrong", "item": "cell-6-1", "response": { "kind": "find_the_note", "string": 4, "fret": 3, "latency_ms": 1500 }, "expected": { "grader": "fretboard_cell.v1", "graded": { "source": "auto_graded", "correct": false, "latency_ms": 1500 } } },
    { "name": "exercise: correct option", "item": "minor-third", "response": { "kind": "option_choice", "option_id": "b", "latency_ms": 4000 }, "expected": { "grader": "exercise_option.v1", "graded": { "source": "auto_graded", "correct": true, "latency_ms": 4000 } } },
    { "name": "exercise: wrong option", "item": "minor-third", "response": { "kind": "option_choice", "option_id": "a", "latency_ms": 4000 }, "expected": { "grader": "exercise_option.v1", "graded": { "source": "auto_graded", "correct": false, "latency_ms": 4000 } } },
    { "name": "play-along: a self-rating with its tempo", "item": "pentatonic-run", "response": { "kind": "self_rating", "rating": "clean", "bpm": 90, "changes_per_minute": null }, "expected": { "grader": "self_rating.v1", "graded": { "source": "self_assessed", "rating": "clean", "bpm": 90, "changes_per_minute": null } } },
    { "name": "chord change: a self-rating with the count", "item": "am-c", "response": { "kind": "self_rating", "rating": "almost", "bpm": null, "changes_per_minute": 42 }, "expected": { "grader": "self_rating.v1", "graded": { "source": "self_assessed", "rating": "almost", "bpm": null, "changes_per_minute": 42 } } },
    { "name": "rejected: a response that doesn't fit the item", "item": "cell-5-3", "response": { "kind": "option_choice", "option_id": "b", "latency_ms": 900 }, "expected": { "rejected": "response_does_not_fit_item" } },
    { "name": "rejected: an option the exercise doesn't have", "item": "minor-third", "response": { "kind": "option_choice", "option_id": "z", "latency_ms": 900 }, "expected": { "rejected": "unknown_option" } },
    { "name": "rejected: a play-along rating without its tempo", "item": "pentatonic-run", "response": { "kind": "self_rating", "rating": "clean", "bpm": null, "changes_per_minute": null }, "expected": { "rejected": "measure_missing" } },
    { "name": "rejected: a chord-change rating without its count", "item": "am-c", "response": { "kind": "self_rating", "rating": "clean", "bpm": null, "changes_per_minute": null }, "expected": { "rejected": "measure_missing" } },
    { "name": "rejected: a negative latency", "item": "cell-5-3", "response": { "kind": "name_the_note", "chosen_note": "C", "latency_ms": -5 }, "expected": { "rejected": "invalid_latency" } }
  ]
}
