{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "MotifPath design tokens. Brand palette derived from logo/svg/motif-path-logo.svg (luminous purple on deep indigo). Semantic roles are theme-aware: every role has a light and a dark value. Consumed by motifpath-web/tailwind.config.ts (ADR-018 decision 1).",

  "brand": {
    "$description": "Theme-independent brand ramp. Use for the logo lockup, marketing surfaces, and teaching-diagram color. UI code uses the semantic roles below, not these.",
    "violet": {
      "50":  { "$type": "color", "$value": "#F4EEFF" },
      "100": { "$type": "color", "$value": "#E4D6FF" },
      "200": { "$type": "color", "$value": "#C9ACFF" },
      "300": { "$type": "color", "$value": "#AD82FF" },
      "400": { "$type": "color", "$value": "#9457FF" },
      "500": { "$type": "color", "$value": "#7C3CFF", "$description": "Core brand violet (logo edge-gradient midpoint)" },
      "600": { "$type": "color", "$value": "#6421FA" },
      "700": { "$type": "color", "$value": "#4714DF", "$description": "Logo ribbon-gradient end" },
      "800": { "$type": "color", "$value": "#360FA6" },
      "900": { "$type": "color", "$value": "#1F0A5E" }
    },
    "lilac":  { "$type": "color", "$value": "#C97CFF", "$description": "Logo note stroke / highlight accent" },
    "ground": { "$type": "color", "$value": "#05072C", "$description": "Logo canvas — deep indigo" }
  },

  "color": {
    "$description": "Semantic roles. { light, dark } — Tailwind config picks per active theme.",

    "surface":        { "$type": "color", "$value": { "light": "#FBFAFF", "dark": "#0B0D2E" }, "$description": "Page background" },
    "surface-raised": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#161942" }, "$description": "Cards, header, popovers" },
    "surface-sunken": { "$type": "color", "$value": { "light": "#F3F0FB", "dark": "#080927" }, "$description": "Insets, code blocks, progress-track background" },
    "border":         { "$type": "color", "$value": { "light": "#E4DEF3", "dark": "#2C2E58" }, "$description": "Hairlines, dividers, input borders" },

    "ink":        { "$type": "color", "$value": { "light": "#1A1633", "dark": "#ECEAFF" }, "$description": "Primary text" },
    "ink-muted":  { "$type": "color", "$value": { "light": "#5B5470", "dark": "#A7A2C8" }, "$description": "Secondary text, captions, section counts" },
    "ink-subtle": { "$type": "color", "$value": { "light": "#9A94AE", "dark": "#6E698C" }, "$description": "Locked path items, disabled controls (PB-8j 'Locked / disabled' role)" },

    "accent":        { "$type": "color", "$value": { "light": "#6D28E0", "dark": "#7C3CFF" }, "$description": "Primary interactive fill — buttons, active nav, current step" },
    "accent-fg":     { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "$description": "Text / icon on accent" },
    "accent-muted":  { "$type": "color", "$value": { "light": "#F0E9FF", "dark": "#241C4D" }, "$description": "Accent-tinted surface — selected row, subtle badge" },
    "accent-text":   { "$type": "color", "$value": { "light": "#6D28E0", "dark": "#B79BFF" }, "$description": "Accent hue for links / icons directly on surface (contrast-safe both themes)" },
    "focus":         { "$type": "color", "$value": { "light": "#6D28E0", "dark": "#B79BFF" }, "$description": "Focus ring" },

    "success":       { "$type": "color", "$value": { "light": "#1E7A4C", "dark": "#3FB985" }, "$description": "Completed step marker on the path (PB-8j — replaces the standalone motif-success placeholder)" },
    "success-fg":    { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#04120B" } },
    "success-muted": { "$type": "color", "$value": { "light": "#E2F3E9", "dark": "#12301F" } },

    "danger":        { "$type": "color", "$value": { "light": "#C4362F", "dark": "#FF7B7C" }, "$description": "Hard failure emphasis, destructive confirm (PB-8j — replaces motif-danger placeholder)" },
    "danger-fg":     { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#1A0606" } },
    "danger-muted":  { "$type": "color", "$value": { "light": "#FBE8E7", "dark": "#3A1414" } }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Avenir Next", "Manrope", "system-ui", "sans-serif"], "$description": "Wordmark face is Avenir Next (not web-licensed). Web display face TBD — Manrope is the interim fallback." },
      "body":    { "$type": "fontFamily", "$value": ["Avenir Next", "Manrope", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$description": "[fontSize, lineHeight] in rem — Tailwind fontSize tuple shape (see PB-34 spike finding: narrow to [string,string] in tailwind.config.ts).",
      "xs":   { "$type": "dimension", "$value": ["0.75rem", "1.125rem"] },
      "sm":   { "$type": "dimension", "$value": ["0.875rem", "1.375rem"] },
      "base": { "$type": "dimension", "$value": ["1rem", "1.5rem"] },
      "lg":   { "$type": "dimension", "$value": ["1.25rem", "1.75rem"] },
      "xl":   { "$type": "dimension", "$value": ["1.75rem", "2.125rem"] },
      "2xl":  { "$type": "dimension", "$value": ["2.5rem", "2.875rem"] }
    }
  },

  "space": {
    "$description": "8-step layout scale (rem). PB-34 spike: spread onto theme.extend.spacing.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "3rem" },
    "8": { "$type": "dimension", "$value": "4rem" }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.25rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "0.875rem" },
    "xl":   { "$type": "dimension", "$value": "1.25rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "elevation": {
    "$description": "{ light, dark } shadow strings. Dark theme uses a deeper indigo shadow; glow-accent is optional emphasis on dark surfaces only.",
    "level0": { "$type": "shadow", "$value": { "light": "none", "dark": "none" } },
    "level1": { "$type": "shadow", "$value": { "light": "0 1px 2px rgba(26,22,51,.06), 0 1px 1px rgba(26,22,51,.04)", "dark": "0 1px 2px rgba(3,4,20,.5)" } },
    "level2": { "$type": "shadow", "$value": { "light": "0 4px 12px rgba(26,22,51,.10)", "dark": "0 6px 18px rgba(3,4,20,.55)" } },
    "level3": { "$type": "shadow", "$value": { "light": "0 12px 32px rgba(26,22,51,.16)", "dark": "0 14px 36px rgba(3,4,20,.65)" } },
    "glow-accent": { "$type": "shadow", "$value": { "light": "0 0 0 rgba(0,0,0,0)", "dark": "0 0 24px rgba(124,60,255,.35)" } }
  }
}
